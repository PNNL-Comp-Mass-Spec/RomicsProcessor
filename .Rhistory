comp_for_log <- gsub("_vs_", "/", comp)
log_col <- paste0("log(", comp_for_log, ")")
if(!log_col %in% colnames(stats)) {
warning(paste("Log fold change column not found:", log_col, ". Available log columns:",
paste(colnames(stats)[grepl("^log\\(", colnames(stats))], collapse = ", ")))
return(list(up = character(0), down = character(0)))
}
up_features <- rownames(stats)[
stats[[p_col]] < p_threshold &
!is.na(stats[[p_col]]) &
stats[[log_col]] > log_threshold
]
down_features <- rownames(stats)[
stats[[p_col]] < p_threshold &
!is.na(stats[[p_col]]) &
stats[[log_col]] < -log_threshold
]
}
if(direction_change) {
return(list(up = up_features, down = down_features))
} else {
return(list(all = unique(c(up_features, down_features))))
}
}
# Function to detect directional discrepancies between tests (internal)
detect_directional_discrepancies <- function(test_features) {
if(length(test_features) < 2) {
return(character(0))
}
test_names <- names(test_features)
discrepant_features <- character(0)
# Check all pairs of tests for directional conflicts
for(i in 1:(length(test_names) - 1)) {
for(j in (i + 1):length(test_names)) {
test1 <- test_names[i]
test2 <- test_names[j]
# Features that are UP in test1 but DOWN in test2
conflict1 <- intersect(test_features[[test1]][["up"]],
test_features[[test2]][["down"]])
# Features that are DOWN in test1 but UP in test2
conflict2 <- intersect(test_features[[test1]][["down"]],
test_features[[test2]][["up"]])
conflicts <- unique(c(conflict1, conflict2))
if(length(conflicts) > 0) {
message(paste("Directional conflicts between", test1, "and", test2, ":", length(conflicts), "features"))
discrepant_features <- unique(c(discrepant_features, conflicts))
}
}
}
return(discrepant_features)
}
# Helper function to combine features using union approach (internal)
combine_features_union <- function(test_features, remove_discrepant) {
directions <- names(test_features[[1]])
combined <- list()
for(direction in directions) {
all_features <- unique(unlist(lapply(test_features, function(tf) tf[[direction]])))
combined[[direction]] <- all_features
}
if(remove_discrepant && "up" %in% directions && "down" %in% directions) {
# Enhanced discrepancy detection between tests
discrepant_features <- detect_directional_discrepancies(test_features)
if(length(discrepant_features) > 0) {
message(paste("Removing", length(discrepant_features), "features with conflicting directions between tests"))
message(paste("Discrepant features:", paste(head(discrepant_features, 5), collapse = ", "),
if(length(discrepant_features) > 5) "..." else ""))
# Remove discrepant features from both directions
combined[["up"]] <- setdiff(combined[["up"]], discrepant_features)
combined[["down"]] <- setdiff(combined[["down"]], discrepant_features)
}
}
return(combined)
}
# Helper function to combine features using intersection approach (internal)
combine_features_intersection <- function(test_features) {
directions <- names(test_features[[1]])
combined <- list()
for(direction in directions) {
# Find intersection across all tests
direction_features <- lapply(test_features, function(tf) tf[[direction]])
intersection_features <- Reduce(intersect, direction_features)
combined[[direction]] <- intersection_features
}
return(combined)
}
# Helper function to process a single test-comparison pair (internal)
process_single_test_comparison <- function(stats, comp, test, p_type, p_threshold,
log_threshold, direction_change, remove_discrepant,
universe, enrichment_type, ontology_type,
stat_type_mapping = NULL) {
message(paste("Processing comparison:", comp, "for", test))
# Use mapping if provided
if(!is.null(stat_type_mapping) && test %in% names(stat_type_mapping)) {
actual_test_name <- stat_type_mapping[test]
} else {
actual_test_name <- test
}
# Get p-value column
p_col <- paste0(comp, "_", actual_test_name, "_", p_type)
if(!p_col %in% colnames(stats)) {
warning(paste("P-value column not found:", p_col))
return(list())
}
# Get log fold change or directionality column
if(test == "glmBinomialTest" || actual_test_name == "glmBinomialTest") {
dir_col <- paste0(comp, "_directionality")
if(!dir_col %in% colnames(stats)) {
warning(paste("Directionality column not found for", comp, "- skipping"))
return(list())
}
up_features <- rownames(stats)[
stats[[p_col]] < p_threshold &
!is.na(stats[[p_col]]) &
stats[[dir_col]] == 1
]
down_features <- rownames(stats)[
stats[[p_col]] < p_threshold &
!is.na(stats[[p_col]]) &
stats[[dir_col]] == -1
]
} else {
# For T-test, construct exact log column name
comp_for_log <- gsub("_vs_", "/", comp)
log_col <- paste0("log(", comp_for_log, ")")
if(!log_col %in% colnames(stats)) {
warning(paste("Log fold change column not found:", log_col))
return(list())
}
up_features <- rownames(stats)[
stats[[p_col]] < p_threshold &
!is.na(stats[[p_col]]) &
stats[[log_col]] > log_threshold
]
down_features <- rownames(stats)[
stats[[p_col]] < p_threshold &
!is.na(stats[[p_col]]) &
stats[[log_col]] < -log_threshold
]
}
# Enhanced discrepancy detection within the same test
if(remove_discrepant) {
within_test_discrepant <- intersect(up_features, down_features)
if(length(within_test_discrepant) > 0) {
message(paste("Removing", length(within_test_discrepant), "features with conflicting directions within", test, "for", comp))
up_features <- setdiff(up_features, within_test_discrepant)
down_features <- setdiff(down_features, within_test_discrepant)
}
}
results <- list()
# Perform enrichment analysis
if(direction_change) {
# Separate up and down
if(length(up_features) > 0) {
message(paste("  Up-regulated features:", length(up_features)))
up_enr <- perform_enrichment(up_features, universe, enrichment_type, ontology_type)
if(nrow(up_enr) > 0) {
up_enr$comparison <- paste0("up_", comp)
results[[length(results) + 1]] <- up_enr
}
}
if(length(down_features) > 0) {
message(paste("  Down-regulated features:", length(down_features)))
down_enr <- perform_enrichment(down_features, universe, enrichment_type, ontology_type)
if(nrow(down_enr) > 0) {
down_enr$comparison <- paste0("down_", comp)
results[[length(results) + 1]] <- down_enr
}
}
} else {
# Combined analysis
all_features <- unique(c(up_features, down_features))
if(length(all_features) > 0) {
message(paste("  Total significant features:", length(all_features)))
combined_enr <- perform_enrichment(all_features, universe, enrichment_type, ontology_type)
if(nrow(combined_enr) > 0) {
combined_enr$comparison <- comp
results[[length(results) + 1]] <- combined_enr
}
}
}
return(results)
}
#' romicsEnrichment()
#' @description Automated enrichment analysis for romics objects with multiple statistical test support
#' @param romics_object A romics_object created using createRomicsObject()
#' @param universe Character vector for universe proteins, if missing uses all proteins from romics_object
#' @param stat_type Character vector indicating statistical test types: c("Ttest", "glmBinomialTest", "LMMTest") (default: "Ttest")
#' @param enrichment_type Character string indicating enrichment test: "Fisher", "EASE", "KS", "Binomial" (default: "EASE")
#' @param ontology_type Character vector indicating databases: c("GO", "KEGG", "REACTOME") (default: all three)
#' @param direction_change Logical indicating whether to separate up/down regulated features (default: TRUE)
#' @param p_threshold Numeric threshold for significance (default: 0.05)
#' @param p_type Character string indicating p-value type: "p" or "padj" (default: "p")
#' @param log_threshold Numeric threshold for log fold change (default: 0, meaning any change)
#' @param remove_discrepant Logical indicating whether to remove features with discrepant results between tests (default: TRUE)
#' @param combine_tests Character string indicating how to combine multiple tests: "union", "intersection" (default: "union" for multiple tests, "separate" for single test)
#' @param report_discrepancies Logical indicating whether to generate a detailed discrepancy report (default: TRUE)
#' @return A data.frame containing enrichment results, or a list with enrichments and discrepancy_report if report_discrepancies=TRUE
#' @examples
#' # Single test
#' enrichments <- romicsEnrichments(romics_object, stat_type = "Ttest")
#'
#' # Multiple tests - automatically combined
#' enrichments <- romicsEnrichments(romics_object,
#'                                 stat_type = c("Ttest", "glmBinomialTest"))
#'
#' # Multiple tests with intersection (more conservative)
#' enrichments <- romicsEnrichments(romics_object,
#'                                 stat_type = c("Ttest", "glmBinomialTest"),
#'                                 combine_tests = "intersection")
#' @author Geremy Clair
#' @export
romicsEnrichment <- function(romics_object,
universe = NULL,
stat_type = "Ttest",
enrichment_type = "EASE",
ontology_type = c("GO", "KEGG", "REACTOME"),
direction_change = TRUE,
p_threshold = 0.05,
p_type = "p",
log_threshold = 0,
remove_discrepant = TRUE,
combine_tests = NULL,
report_discrepancies = TRUE) {
# Input validation
if(!is.romics_object(romics_object)) {
stop("Input must be a valid romics_object")
}
if(!"statistics" %in% names(romics_object)) {
stop("romics_object must contain a statistics layer")
}
# Map user-friendly names to actual column names
stat_type_mapping <- c(
"Ttest" = "Ttest",
"glmBinomialTest" = "glmBinomialTest",
"LMMTest" = "LMMTest"
)
if(!all(stat_type %in% names(stat_type_mapping))) {
stop("stat_type must contain only: 'Ttest', 'glmBinomialTest', 'LMMTest'")
}
if(!enrichment_type %in% c("Fisher", "EASE", "KS", "Binomial")) {
stop("enrichment_type must be one of: 'Fisher', 'EASE', 'KS', 'Binomial'")
}
if(!all(ontology_type %in% c("GO", "KEGG", "REACTOME"))) {
stop("ontology_type must contain only: 'GO', 'KEGG', 'REACTOME'")
}
if(!p_type %in% c("p", "padj")) {
stop("p_type must be either 'p' or 'padj'")
}
if(!is.null(combine_tests) && !combine_tests %in% c("separate", "union", "intersection")) {
stop("combine_tests must be one of: 'separate', 'union', 'intersection'")
}
# Set default combine_tests behavior
if(is.null(combine_tests)) {
if(length(stat_type) == 1) {
combine_tests <- "separate"
} else {
combine_tests <- "union"  # Default to union for multiple tests
message("Multiple tests detected - combining results using 'union' approach")
}
}
# Set universe if not provided
if(is.null(universe)) {
universe <- rownames(romics_object$data)
}
# Get statistics data
stats <- romics_object$statistics
# Find available comparisons for each test type
test_comparisons <- list()
for(test in stat_type) {
# Use the actual column name
actual_test_name <- stat_type_mapping[test]
p_pattern <- paste0("_", actual_test_name, "_", p_type, "$")
p_cols <- colnames(stats)[grepl(p_pattern, colnames(stats))]
if(length(p_cols) == 0) {
warning(paste("No", test, "results found in statistics layer"))
message(paste("Searched for pattern:", p_pattern))
next
}
comparisons <- gsub(p_pattern, "", p_cols)
test_comparisons[[test]] <- comparisons
message(paste("Found", length(comparisons), "comparisons for", test, ":", paste(head(comparisons, 3), collapse = ", ")))
}
# Remove empty test types
test_comparisons <- test_comparisons[lengths(test_comparisons) > 0]
stat_type <- names(test_comparisons)
if(length(stat_type) == 0) {
stop("No valid statistical test results found in the statistics layer")
}
# Generate discrepancy report if requested and multiple tests
discrepancy_report <- NULL
if(report_discrepancies && length(stat_type) > 1 && combine_tests != "separate") {
message("=== Generating Discrepancy Report ===")
discrepancy_report <- analyze_test_discrepancies(romics_object, stat_type, p_threshold, p_type, stat_type_mapping)
}
# Process tests
if(length(stat_type) == 1 || combine_tests == "separate") {
# Process each test separately (for single test or when explicitly requested)
all_enrichments <- list()
counter <- 1
for(test in stat_type) {
if(!test %in% names(test_comparisons)) next
message(paste("=== Processing", test, "==="))
for(comp in test_comparisons[[test]]) {
result <- process_single_test_comparison(stats, comp, test, p_type, p_threshold,
log_threshold, direction_change, remove_discrepant,
universe, enrichment_type, ontology_type, stat_type_mapping)
if(length(result) > 0) {
for(res in result) {
if(nrow(res) > 0) {
# Only add test_type column if there are multiple tests being processed separately
if(length(stat_type) > 1) {
res$test_type <- test
}
all_enrichments[[counter]] <- res
counter <- counter + 1
}
}
}
}
}
} else {
# Combine multiple tests (union or intersection)
# Find common comparisons across all test types
common_comparisons <- Reduce(intersect, test_comparisons)
if(length(common_comparisons) == 0) {
stop("No common comparisons found across all specified test types")
}
message(paste("Found", length(common_comparisons), "common comparisons across",
paste(stat_type, collapse = ", ")))
message(paste("Using", combine_tests, "approach to combine test results"))
all_enrichments <- list()
counter <- 1
for(comp in common_comparisons) {
message(paste("Processing comparison:", comp))
# Extract features from each test type
test_features <- list()
for(test in stat_type) {
features <- extract_features_from_test(stats, comp, test, p_type, p_threshold,
log_threshold, direction_change, stat_type_mapping)
test_features[[test]] <- features
}
# Combine features based on strategy
if(combine_tests == "union") {
combined_features <- combine_features_union(test_features, remove_discrepant)
} else if(combine_tests == "intersection") {
combined_features <- combine_features_intersection(test_features)
}
# Perform enrichment analysis
for(direction in names(combined_features)) {
features <- combined_features[[direction]]
if(length(features) > 0) {
message(paste("  ", direction, "features:", length(features)))
# Add test composition info for tracking
test_counts <- sapply(test_features, function(tf) length(tf[[direction]]))
enr_result <- perform_enrichment(features, universe, enrichment_type, ontology_type)
if(nrow(enr_result) > 0) {
enr_result$comparison <- paste0(direction, "_", comp)
# Add metadata about the combination process
enr_result$tests_combined <- paste(stat_type, collapse = "+")
enr_result$combination_method <- combine_tests
# Add counts for transparency
for(test in stat_type) {
enr_result[[paste0("n_features_", test)]] <- test_counts[test]
}
# Add overlap information for union
if(combine_tests == "union" && length(stat_type) == 2) {
overlap <- length(intersect(test_features[[stat_type[1]]][[direction]],
test_features[[stat_type[2]]][[direction]]))
enr_result$n_overlapping_features <- overlap
}
all_enrichments[[counter]] <- enr_result
counter <- counter + 1
}
}
}
}
}
# Combine all results
if(length(all_enrichments) == 0) {
warning("No enrichment results generated")
final_results <- data.frame()
} else {
final_results <- do.call(rbind, all_enrichments)
rownames(final_results) <- NULL
if(length(stat_type) > 1 && combine_tests != "separate") {
message(paste("Enrichment analysis completed using", combine_tests, "of", paste(stat_type, collapse = " + ")))
message(paste("Total results:", nrow(final_results)))
} else {
message(paste("Enrichment analysis completed. Total results:", nrow(final_results)))
}
}
# Return results
if(report_discrepancies && !is.null(discrepancy_report)) {
return(list(
enrichments = final_results,
discrepancy_report = discrepancy_report
))
} else {
return(final_results)
}
}
#' analyze_test_discrepancies()
#' @description Analyze and report directional discrepancies between statistical tests
#' @param romics_object A romics_object with multiple test results
#' @param stat_types Vector of statistical test types to analyze
#' @param p_threshold P-value threshold for significance
#' @param p_type Type of p-value ("p" or "padj")
#' @param stat_type_mapping Optional mapping of user names to actual column names
#' @return A list containing detailed discrepancy reports for each comparison
#' @examples
#' discrepancy_report <- analyze_test_discrepancies(romics_object,
#'                                                 c("Ttest", "glmBinomialTest"))
#' @author Geremy Clair
#' @export
analyze_test_discrepancies <- function(romics_object, stat_types, p_threshold = 0.05, p_type = "p", stat_type_mapping = NULL) {
stats <- romics_object$statistics
# Find common comparisons
test_comparisons <- list()
for(test in stat_types) {
# Use mapping if provided
if(!is.null(stat_type_mapping) && test %in% names(stat_type_mapping)) {
actual_test_name <- stat_type_mapping[test]
} else {
actual_test_name <- test
}
p_pattern <- paste0("_", actual_test_name, "_", p_type, "$")
p_cols <- colnames(stats)[grepl(p_pattern, colnames(stats))]
comparisons <- gsub(p_pattern, "", p_cols)
test_comparisons[[test]] <- comparisons
}
common_comparisons <- Reduce(intersect, test_comparisons)
discrepancy_report <- list()
for(comp in common_comparisons) {
message(paste("Analyzing discrepancies for comparison:", comp))
# Extract features from each test
test_features <- list()
for(test in stat_types) {
features <- extract_features_from_test(stats, comp, test, p_type, p_threshold, 0, TRUE, stat_type_mapping)
test_features[[test]] <- features
}
# Detect discrepancies
discrepant <- detect_directional_discrepancies(test_features)
# Create detailed report
comp_report <- list(
comparison = comp,
total_discrepant = length(discrepant),
discrepant_features = discrepant
)
# Add details for each test pair
test_names <- names(test_features)
pair_details <- list()
if(length(test_names) > 1) {
for(i in 1:(length(test_names) - 1)) {
for(j in (i + 1):length(test_names)) {
test1 <- test_names[i]
test2 <- test_names[j]
conflict1 <- intersect(test_features[[test1]][["up"]], test_features[[test2]][["down"]])
conflict2 <- intersect(test_features[[test1]][["down"]], test_features[[test2]][["up"]])
pair_key <- paste(test1, "vs", test2)
pair_details[[pair_key]] <- list(
up_in_test1_down_in_test2 = conflict1,
down_in_test1_up_in_test2 = conflict2,
total_conflicts = length(unique(c(conflict1, conflict2)))
)
}
}
}
comp_report$pair_details <- pair_details
discrepancy_report[[comp]] <- comp_report
}
return(discrepancy_report)
}
enrichments <- romicsEnrichment(romics_proteins, stat_type = c("Ttest", "glmBinomialTest"), ontology_type = c("GO", "KEGG"), direction_change = TRUE, enrichment_type = "Binomial")
enrichments <- enrichments$enrichments
enrichments <- proteinEnrichmentFilter(enrichments, Test_p_type = "p", Test_p_max = 0.05)
#bubble plots were plotted
proteinEnrichmentBubblePlot(enrichments, comparison_column = "comparison", ontology_filter = "KEGG_pathway")
proteinEnrichmentBubblePlot(enrichments, comparison_column = "comparison", ontology_filter = "GO_BP")
romicsSteps(romics_proteins, show_dates = TRUE, show_details = TRUE)
romics_pipeline<-romicsCreatePipeline(romics_proteins)
romics_restored_original <- resetRomicsObject(romics_proteins, main_factor = "growth_media")
