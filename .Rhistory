IPF1_vs_Ctrl_down_IPF1<- rownames(romics_proteins$statistics)[romics_proteins$statistics$IPF1_vs_Ctrl_Ttest_padj<0.05&!is.na(romics_proteins$statistics$IPF1_vs_Ctrl_Ttest_padj)&romics_proteins$statistics$`log(IPF1/Ctrl)`<0|romics_proteins$statistics$IPF1_vs_Ctrl_glmBionomialTest_padj<0.05&romics_proteins$statistics$IPF1_vs_Ctrl_directionality==1]
u <- IPF1_vs_Ctrl_up_IPF1[IPF1_vs_Ctrl_up_IPF1 %in% IPF1_vs_Ctrl_down_IPF1]
IPF1_vs_Ctrl_up_IPF1<-IPF1_vs_Ctrl_up_IPF1[!IPF1_vs_Ctrl_up_IPF1 %in% u]
IPF1_vs_Ctrl_down_IPF1<-IPF1_vs_Ctrl_down_IPF1[!IPF1_vs_Ctrl_down_IPF1 %in% u]
IPF2_vs_Ctrl_up_IPF2<- rownames(romics_proteins$statistics)[romics_proteins$statistics$IPF2_vs_Ctrl_Ttest_padj<0.05&!is.na(romics_proteins$statistics$IPF2_vs_Ctrl_Ttest_padj)&romics_proteins$statistics$`log(IPF2/Ctrl)`>0|romics_proteins$statistics$IPF2_vs_Ctrl_glmBionomialTest_padj<0.05&romics_proteins$statistics$IPF2_vs_Ctrl_directionality==1]
IPF2_vs_Ctrl_down_IPF2<- rownames(romics_proteins$statistics)[romics_proteins$statistics$IPF2_vs_Ctrl_Ttest_padj<0.05&!is.na(romics_proteins$statistics$IPF2_vs_Ctrl_Ttest_padj)&romics_proteins$statistics$`log(IPF2/Ctrl)`<0|romics_proteins$statistics$IPF2_vs_Ctrl_glmBionomialTest_padj<0.05&romics_proteins$statistics$IPF2_vs_Ctrl_directionality==1]
u <- IPF2_vs_Ctrl_up_IPF2[IPF2_vs_Ctrl_up_IPF2 %in% IPF2_vs_Ctrl_down_IPF2]
IPF2_vs_Ctrl_up_IPF2<-IPF2_vs_Ctrl_up_IPF2[!IPF2_vs_Ctrl_up_IPF2 %in% u]
IPF2_vs_Ctrl_down_IPF2<-IPF2_vs_Ctrl_down_IPF2[!IPF2_vs_Ctrl_down_IPF2 %in% u]
IPF3_vs_Ctrl_up_IPF3<- rownames(romics_proteins$statistics)[romics_proteins$statistics$IPF3_vs_Ctrl_Ttest_padj<0.05&!is.na(romics_proteins$statistics$IPF3_vs_Ctrl_Ttest_padj)&romics_proteins$statistics$`log(IPF3/Ctrl)`>0|romics_proteins$statistics$IPF3_vs_Ctrl_glmBionomialTest_padj<0.05&romics_proteins$statistics$IPF3_vs_Ctrl_directionality==1]
IPF3_vs_Ctrl_down_IPF3<- rownames(romics_proteins$statistics)[romics_proteins$statistics$IPF3_vs_Ctrl_Ttest_padj<0.05&!is.na(romics_proteins$statistics$IPF3_vs_Ctrl_Ttest_padj)&romics_proteins$statistics$`log(IPF3/Ctrl)`<0|romics_proteins$statistics$IPF3_vs_Ctrl_glmBionomialTest_padj<0.05&romics_proteins$statistics$IPF3_vs_Ctrl_directionality==1]
u <- IPF3_vs_Ctrl_up_IPF3[IPF3_vs_Ctrl_up_IPF3 %in% IPF3_vs_Ctrl_down_IPF3]
IPF3_vs_Ctrl_up_IPF3<-IPF3_vs_Ctrl_up_IPF3[!IPF3_vs_Ctrl_up_IPF3 %in% u]
IPF3_vs_Ctrl_down_IPF3<-IPF3_vs_Ctrl_down_IPF3[!IPF3_vs_Ctrl_down_IPF3 %in% u]
IPF3_vs_IPF1_up_IPF3<- rownames(romics_proteins$statistics)[romics_proteins$statistics$IPF3_vs_IPF1_Ttest_padj<0.05&!is.na(romics_proteins$statistics$IPF3_vs_IPF1_Ttest_padj)&romics_proteins$statistics$`log(IPF3/IPF1)`>0|romics_proteins$statistics$IPF3_vs_IPF1_glmBionomialTest_padj<0.05&romics_proteins$statistics$IPF3_vs_IPF1_directionality==1]
IPF3_vs_IPF1_down_IPF3<- rownames(romics_proteins$statistics)[romics_proteins$statistics$IPF3_vs_IPF1_Ttest_padj<0.05&!is.na(romics_proteins$statistics$IPF3_vs_IPF1_Ttest_padj)&romics_proteins$statistics$`log(IPF3/IPF1)`<0|romics_proteins$statistics$IPF3_vs_IPF1_glmBionomialTest_padj<0.05&romics_proteins$statistics$IPF3_vs_IPF1_directionality==1]
u <- IPF3_vs_IPF1_up_IPF3[IPF3_vs_IPF1_up_IPF3 %in% IPF3_vs_IPF1_down_IPF3]
IPF3_vs_IPF1_up_IPF3<-IPF3_vs_IPF1_up_IPF3[!IPF3_vs_IPF1_up_IPF3 %in% u]
IPF3_vs_IPF1_down_IPF3<-IPF3_vs_IPF1_down_IPF3[!IPF3_vs_IPF1_down_IPF3 %in% u]
