IPF3_vs_IPF1_down_IPF3_enr<-Enrich_EASE(IPF3_vs_IPF1_down_IPF3,universe)
enrichments<-enrfilter(rbind(cbind(enriched_in="IPF1_vs_Ctrl_up_IPF1",IPF1_vs_Ctrl_up_IPF1_enr),
cbind(enriched_in="IPF1_vs_Ctrl_down_IPF1",IPF1_vs_Ctrl_down_IPF1_enr),
cbind(enriched_in="IPF2_vs_Ctrl_up_IPF2",IPF2_vs_Ctrl_up_IPF2_enr),
cbind(enriched_in="IPF2_vs_Ctrl_down_IPF1",IPF1_vs_Ctrl_down_IPF1_enr),
cbind(enriched_in="IPF3_vs_Ctrl_up_IPF3",IPF3_vs_Ctrl_up_IPF3_enr),
cbind(enriched_in="IPF3_vs_Ctrl_down_IPF3",IPF3_vs_Ctrl_down_IPF3_enr),
cbind(enriched_in="IPF3_vs_IPF1_up_IPF3",IPF3_vs_IPF1_up_IPF3_enr),
cbind(enriched_in="IPF3_vs_IPF1_down_IPF3",IPF3_vs_IPF1_down_IPF3_enr)),pval = 0.05,pval_type = "pval",min_feature = 2)
datatable(enrichments)
